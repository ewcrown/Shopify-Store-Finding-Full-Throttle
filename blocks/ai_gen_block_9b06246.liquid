{% doc %}
  @prompt
    Create a custom HTML section that allows merchants to paste their own HTML code directly into a Liquid section file. The section should include a content block with a raw HTML area, support for custom CSS and JavaScript embedded within the HTML, and render cleanly within the theme's existing header and footer layout. The section should be flexible enough to handle any custom HTML page content.
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-html-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    display: block;
  }

  .ai-custom-html-container-{{ ai_gen_id }} {
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-custom-html-empty-state-{{ ai_gen_id }} {
    padding: 60px 20px;
    text-align: center;
    background-color: #f9fafb;
    border: 2px dashed #d1d5db;
    border-radius: 8px;
    color: #6b7280;
  }

  .ai-custom-html-empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
    color: #374151;
  }

  .ai-custom-html-empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 14px;
  }
{% endstyle %}

<div class="ai-custom-html-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-html-container-{{ ai_gen_id }}">
    {% if block.settings.custom_html != blank %}
      {{ block.settings.custom_html }}
    {% else %}
      <div class="ai-custom-html-empty-state-{{ ai_gen_id }}">
        <h3>Custom HTML block</h3>
        <p>Add your HTML, CSS, and JavaScript in the block settings</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom HTML",
  "settings": [
    {
      "type": "header",
      "content": "HTML content"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "HTML code"
    },
    {
      "type": "paragraph",
      "content": "Paste your complete HTML code here. You can include inline CSS within <style> tags and JavaScript within <script> tags."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom HTML"
    }
  ]
}
{% endschema %}
