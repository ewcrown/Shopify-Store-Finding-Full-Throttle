{% doc %}
  @prompt
    Create a custom HTML section that allows merchants to paste their own HTML code directly into a Liquid section file. The section should include a content block with a raw HTML area, support for custom CSS and JavaScript embedded within the HTML, and render cleanly within the theme's existing header and footer layout. The section should be flexible enough to handle any custom HTML page content.
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-html-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-custom-html-container-{{ ai_gen_id }} {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-html-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<custom-html-{{ ai_gen_id }}
  class="ai-custom-html-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-custom-html-container-{{ ai_gen_id }}">
    {% if block.settings.custom_html != blank %}
      {{ block.settings.custom_html }}
    {% else %}
      <div style="padding: 40px; text-align: center; background-color: #f4f4f4; border-radius: 8px;">
        <p style="color: #666; margin: 0;">Add your custom HTML code in the block settings</p>
      </div>
    {% endif %}
  </div>
</custom-html-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomHtml{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.executeScripts();
      }

      executeScripts() {
        const scripts = this.querySelectorAll('script');
        scripts.forEach((oldScript) => {
          const newScript = document.createElement('script');
          Array.from(oldScript.attributes).forEach((attr) => {
            newScript.setAttribute(attr.name, attr.value);
          });
          newScript.textContent = oldScript.textContent;
          oldScript.parentNode.replaceChild(newScript, oldScript);
        });
      }
    }

    customElements.define('custom-html-{{ ai_gen_id }}', CustomHtml{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Custom HTML",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "HTML content"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "Custom HTML"
    },
    {
      "type": "paragraph",
      "content": "Paste your HTML code above. You can include inline CSS within <style> tags and JavaScript within <script> tags."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Custom HTML"
    }
  ]
}
{% endschema %}
