{% comment %}
  Renders Free shipping message

  Accepts:
  - message: {String} Free shipping text (required)
  - gradient: {String} Progress bar gradient color
  - show_wheel: {Boolean} Show progress wheel
  - show_progress_bar: {Boolean} Show progress bar
  - is_cart_drawer: {Boolean} Is cart drawer

  Usage:
  {% render 'free-shipping', message: block.settings.message, show_wheel: true, show_progress_bar: false, is_cart_drawer: false %}
{% endcomment %}

{%- liquid
  assign free_shipping_limit = settings.free_shipping_limit
  assign show_message = false
  if message != blank
    assign show_message = true
  endif

  if gradient != blank
    assign style = '--FREE-SHIPPING-GRADIENT: ' | append: gradient | append: ';'
  endif
-%}

{%- if show_message -%}
  {%- liquid
    assign free_shipping_limit = settings.free_shipping_limit | plus: 0
    assign free_gift_threshold_raw = settings.free_gift_threshold | default: '99'
    assign free_gift_product_handle = settings.free_gift_product | default: ''
    assign free_shirt_threshold_raw = settings.free_shirt_threshold | default: free_gift_threshold_raw
    assign free_shirt_threshold = free_shirt_threshold_raw | plus: 0
    assign free_shirt_product_handle = settings.free_shirt_product | default: ''
    assign key_tag_offer_enabled = false
    assign shirt_offer_enabled = false
    if settings.enable_free_gift and settings.enable_key_tag_offer
      assign key_tag_offer_enabled = true
    endif
    if settings.enable_free_gift and settings.enable_shirt_offer and free_shirt_product_handle != blank
      assign shirt_offer_enabled = true
    endif
    if free_shirt_product_handle == blank
      assign free_shirt_product_handle = free_gift_product_handle
    endif
    
    assign max_limit = free_shirt_threshold
    if free_shirt_threshold < free_shipping_limit
      assign max_limit = free_shipping_limit
    endif
    
    if shirt_offer_enabled
      assign progress_max = free_shirt_threshold
    else
      assign progress_max = free_shipping_limit
    endif
    
    assign limit_currency = free_shipping_limit | times: 100
    assign subtotal_without_currency = cart.total_price | plus: 0 | divided_by: 100
    
    assign percent_to_free_shipping = free_shipping_limit | minus: subtotal_without_currency | times: 100 | divided_by: free_shipping_limit
    assign percent_to_free_shipping = 100 | minus: percent_to_free_shipping
    
    assign percent_to_free_gift = progress_max | minus: subtotal_without_currency | times: 100 | divided_by: progress_max
    assign percent_to_free_gift = 100 | minus: percent_to_free_gift
    
    if subtotal_without_currency > progress_max
      assign percent = 100
    else
      assign percent = percent_to_free_gift
    endif
    
    assign milestone_75_percent = free_shipping_limit | times: 100 | divided_by: progress_max
    assign milestone_99_percent = 100
    
    if settings.currency_code_enable
      assign limit_currency = limit_currency | minus: cart.total_price | money_with_currency
    else
      assign limit_currency = limit_currency | minus: cart.total_price | money_without_trailing_zeros
    endif

    capture left_to_spend
      echo '<span data-left-to-spend>' | append: limit_currency | append: '</span>'
    endcapture

    assign message = message | replace: '||amount||', left_to_spend
    assign qualified_shipping_message = ''
    
    assign free_gift_product = all_products[free_gift_product_handle]
    assign free_gift_product_title = 'Free Gift'
    if free_gift_product.title != blank
        assign free_gift_product_title = free_gift_product.title 
    endif
    
    if subtotal_without_currency >= free_shipping_limit and shirt_offer_enabled and subtotal_without_currency >= free_shirt_threshold
      assign qualified_shipping_message = 'Congratulations! Your order qualifies for free shipping with a free gift'
    elsif subtotal_without_currency >= free_shipping_limit and shirt_offer_enabled and subtotal_without_currency < free_shirt_threshold
      assign free_gift_threshold_cents = free_shirt_threshold | times: 100
      assign amount_needed_cents = free_gift_threshold_cents | minus: cart.total_price
      if amount_needed_cents < 0
        assign amount_needed_cents = 0
      endif
      if settings.currency_code_enable
        assign amount_needed_formatted = amount_needed_cents | money_with_currency
      else
        assign amount_needed_formatted = amount_needed_cents | money_without_trailing_zeros
      endif
      capture gift_message
        echo 'You are '
        echo amount_needed_formatted
        echo ' away from a FREE Key Tag!'
      endcapture
      assign qualified_shipping_message = gift_message
    elsif subtotal_without_currency >= free_shipping_limit
      assign qualified_shipping_message = 'Congratulations! Your order qualifies for free shipping'
    else
      assign shipping_limit_cents = free_shipping_limit | times: 100
      assign amount_needed_cents = shipping_limit_cents | minus: cart.total_price
      if amount_needed_cents < 0
        assign amount_needed_cents = 0
      endif
      if settings.currency_code_enable
        assign amount_needed_formatted = amount_needed_cents | money_with_currency
      else
        assign amount_needed_formatted = amount_needed_cents | money_without_trailing_zeros
      endif
      capture shipping_message
        echo 'You are '
        echo amount_needed_formatted
        echo ' away from FREE SHIPPING!'
      endcapture
      assign qualified_shipping_message = shipping_message
    endif

    capture free_shipping_classes
      if is_cart_drawer
        echo 'drawer__message '
      endif

      if template.name == 'cart'
        echo 'cart__message '
      endif

      echo 'free-shipping'

      if subtotal_without_currency >= free_shipping_limit and qualified_shipping_message != blank
        echo ' is-success'
      endif
      
      if subtotal_without_currency >= free_shipping_limit
        echo ' has-free-shipping'
      endif
      
      if shirt_offer_enabled and subtotal_without_currency >= free_shirt_threshold
        echo ' has-free-gift'
      endif
    endcapture
  -%}

  {%- style -%}
    .free-shipping__default-message,
    .free-shipping__success-message {
      display: block;
      text-align: center;
      font-size: 14px;
      line-height: 1.5;
      color: #333333;
      font-weight: 600;
      margin-bottom: 12px;
    }
    
    .free-shipping__progress-wrapper {
      position: relative;
      width: 95%;
      margin-top: 8px;
    }
    
    .free-shipping__progress-bar-holder {
      position: relative;
      width: 100%;
      height: 8px;
    }
    
    .free-shipping__progress-bar {
      width: 100%;
      height: 8px;
      border-radius: 4px;
      background-color: #e5e5e5;
      border: none;
      overflow: visible;
      position: relative;
      -webkit-appearance: none;
      appearance: none;
    }
    
    .free-shipping__progress-bar::-webkit-progress-bar {
      background-color: #e5e5e5;
      border-radius: 4px;
    }
    
    .free-shipping__progress-bar::-webkit-progress-value {
      background: linear-gradient(to right, #ff7b00, #f5a623, #ffcc33);
      border-radius: 4px;
      transition: width 0.3s ease;
    }
    
    .free-shipping__progress-bar::-moz-progress-bar {
      background: linear-gradient(to right, #ff7b00, #f5a623, #ffcc33);
      border-radius: 4px;
    }
    
    .free-shipping__milestones {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    
    .free-shipping__milestone {
      position: absolute;
      top: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 2;
    }
    
    .free-shipping__milestone-point {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #f5a623;
      border: 3px dashed #f5a623;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 3;
      transition: all 0.3s ease;
      flex-shrink: 0;
      box-shadow: 0 0 0 2px #ffffff;
    }
    
    .free-shipping__milestone-point.is-reached {
      background: #f5a623;
      border-color: #f5a623;
      box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px rgba(245, 166, 35, 0.3);
      transform: scale(1.1);
    }
    
    .free-shipping__milestone-icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
    }
    
    .free-shipping__milestone-icon svg {
      width: 18px;
      height: 18px;
      display: block;
    }
    
    .free-shipping__milestone-icon .icon {
      width: 18px;
      height: 18px;
      stroke: #ffffff;
      fill: #ffffff;
      stroke-width: 2;
    }
    
    .free-shipping__milestone-label {
      position: absolute;
      top: 100%;
      left: 10px;
      transform: translateX(-50%);
      margin-top: 10px;
      white-space: nowrap;
      font-size: 13px;
      line-height: 1.5;
      text-align: center;
      color: #333333;
      font-weight: 500;
      pointer-events: none;
      letter-spacing: 0.01em;
      width: auto;
      max-width: none;
    }
    
    .free-shipping__milestone.is-reached .free-shipping__milestone-label {
      color: #f5a623;
      font-weight: 600;
    }
    
    .free-shipping__milestone-label-text {
      display: inline-block;
      text-align: center;
      white-space: nowrap;
    }
    
    /* Free Shipping label - always on one line */
    .free-shipping__milestone--shipping .free-shipping__milestone-label {
      white-space: nowrap !important;
      max-width: none !important;
      width: auto !important;
      top: 90%;
      line-height: 1.5;
      margin-top: 10px;
    }
    
    .free-shipping__milestone--shipping .free-shipping__milestone-label-text {
      white-space: nowrap !important;
      display: inline-block !important;
      line-height: 1.5;
    }
    
    /* Free gift label - same styling as shipping, but can wrap if needed */
    .free-shipping__milestone--gift .free-shipping__milestone-label {
      top: 90%;
      line-height: 1.5;
      margin-top: 10px;
      white-space: normal;
      max-width: 100px;
      word-wrap: break-word;
      hyphens: auto;
    }
    
    .free-shipping__milestone--gift .free-shipping__milestone-label-text {
      display: block;
      text-align: center;
      line-height: 1.5;
    }
    
    .free-shipping__milestone-labels {
      display: none; /* Hide old label container */
    }
    
    @media (max-width: 480px) {
      .free-shipping__milestone-point {
        width: 28px;
        height: 28px;
      }
      
      .free-shipping__milestone-icon {
        width: 16px;
        height: 16px;
      }
      
      .free-shipping__milestone-icon .icon {
        width: 16px;
        height: 16px;
      }
      
      .free-shipping__milestone-label {
        font-size: 11px;
        margin-top: 8px;
        line-height: 1.5;
      }
      
      .free-shipping__milestone--shipping .free-shipping__milestone-label {
        font-size: 11px;
        margin-top: 8px;
        line-height: 1.5;
      }
      
      .free-shipping__milestone--gift .free-shipping__milestone-label {
        max-width: 90px;
        font-size: 11px; 
        margin-top: 8px;
        line-height: 1.5;
      }
      
      .free-shipping__default-message,
      .free-shipping__success-message {
        font-size: 13px;
        margin-bottom: 10px;
      }
    }
  {%- endstyle -%}
  
  <div class="{{ free_shipping_classes }}"
    data-free-shipping="{% if qualified_shipping_message != blank %}true{% else %}false{% endif %}"
    data-free-shipping-limit="{{ free_shipping_limit }}"
    data-free-gift-threshold="{{ free_shirt_threshold }}"
    data-free-gift-product-handle="{{ free_shirt_product_handle }}"
    data-free-shirt-threshold="{{ free_shirt_threshold }}"
    data-free-shirt-product-handle="{{ free_shirt_product_handle }}"
    data-enable-key-tag-offer="{% if key_tag_offer_enabled %}true{% else %}false{% endif %}"
    data-enable-shirt-offer="{% if shirt_offer_enabled %}true{% else %}false{% endif %}"
    data-free-gift-variant-id="{% if free_gift_product and free_gift_product.selected_or_first_available_variant %}{{ free_gift_product.selected_or_first_available_variant.id }}{% endif %}"
    data-milestone-75-percent="{{ milestone_75_percent }}"
    {% if style != blank %}
      style="{{ style }}"
    {% endif %}
  >
    {%- if show_wheel -%}
      <div class="free-shipping__graph" data-progress-graph style="--stroke-dashoffset: 87.96459430051421;">
        <svg height="18" width="18" viewBox="0 0 18 18">
          <circle r="7" cx="9" cy="9" />
          <circle class="free-shipping__graph-progress" stroke-dasharray="87.96459430051421 87.96459430051421" r="7" cx="9" cy="9" />
        </svg>
      </div>
    {%- endif -%}

    {%- if qualified_shipping_message != blank -%}
      <span class="free-shipping__success-message{% if subtotal_without_currency < free_shipping_limit %} free-shipping__default-message{% endif %}">{{ qualified_shipping_message }}</span>
    {%- elsif message != blank -%}
      <span class="free-shipping__default-message">
        {{ message }}
      </span>
    {%- endif -%}

    {%- if show_progress_bar -%}
      <div class="free-shipping__progress-wrapper">
        <div class="free-shipping__progress-bar-holder">
          <progress class="free-shipping__progress-bar" data-progress-bar value="{{ percent }}" max="100"></progress>
          
          {%- comment -%} Milestone points on the progress bar with labels below {%- endcomment -%}
          <div class="free-shipping__milestones">
            {%- comment -%} Free Shipping Milestone at $75 {%- endcomment -%}
            <div class="free-shipping__milestone free-shipping__milestone--shipping" 
                 style="left: {{ milestone_75_percent }}%"
                 data-milestone-type="shipping"
                 data-milestone-percent="{{ milestone_75_percent }}">
              <div class="free-shipping__milestone-point">
                <span class="free-shipping__milestone-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M1 12h4l2-4h12l2 4h4v2h-2v6c0 1.1-.9 2-2 2h-2c-1.1 0-2-.9-2-2v-2H9v2c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2v-6H1v-2z"/>
                    <circle cx="7" cy="18" r="1.5" fill="currentColor"/>
                    <circle cx="17" cy="18" r="1.5" fill="currentColor"/>
                    <path d="M22 8l-1.5-1-1.5 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none" opacity="0.6"/>
                  </svg>
                </span>
              </div>
              <div class="free-shipping__milestone-label">
                <span class="free-shipping__milestone-label-text">Free Shipping & Key Tag</span>
              </div>
            </div>
            
            {%- comment -%} Free Gift Milestone at $99 {%- endcomment -%}
            {%- if shirt_offer_enabled -%}
              <div class="free-shipping__milestone free-shipping__milestone--gift" 
                   style="left: {{ milestone_99_percent }}%"
                   data-milestone-type="gift"
                   data-milestone-percent="{{ milestone_99_percent }}">
                <div class="free-shipping__milestone-point">
                  <span class="free-shipping__milestone-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1">
                      <rect x="6" y="9" width="12" height="9" rx="1" fill="currentColor"/>
                      <path d="M12 9V7c0-1.1.9-2 2-2h2c1.1 0 2 .9 2 2v2M12 9V7c0-1.1-.9-2-2-2H8c-1.1 0-2 .9-2 2v2" stroke="currentColor" stroke-width="1.2" fill="none"/>
                      <path d="M12 10l-1.5 3 1.5 3 1.5-3L12 10z" fill="currentColor" opacity="0.95"/>
                      <path d="M10 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </span>
                </div>
                <div class="free-shipping__milestone-label">
                  <span class="free-shipping__milestone-label-text">Free Shirt</span>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
        
        {%- comment -%} Legacy label container - hidden {%- endcomment -%}
        <div class="free-shipping__milestone-labels" style="display: none;"></div>
      </div>
    {%- endif -%}

    <div class="confetti">
      <span class="confetti__dot confetti__dot--1"></span>
      <span class="confetti__dot confetti__dot--2"></span>
      <span class="confetti__dot confetti__dot--3"></span>
      <span class="confetti__dot confetti__dot--4"></span>
      <span class="confetti__dot confetti__dot--5"></span>
      <span class="confetti__dot confetti__dot--6"></span>
    </div>
  </div>
{%- endif -%}
