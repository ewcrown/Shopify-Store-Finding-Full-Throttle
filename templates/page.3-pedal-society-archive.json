            "custom_html": "<meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>3 Pedal Stories — Finding Full Throttle</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    :root {\n      --black: #0a0a0a;\n      --black-mid: #111111;\n      --black-light: #1a1a1a;\n      --gold: #F4C012;\n      --cobalt: #2E6FD4;\n      --red: #C0392B;\n      --white: #ffffff;\n      --gray: #888888;\n      --light-gray: #cccccc;\n    }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      background-color: var(--black);\n      color: var(--white);\n      font-family: 'Arial Narrow', Arial, sans-serif;\n      line-height: 1.5;\n      overflow-x: hidden;\n    }\n\n    /* ─── NAV ─── */\n    nav {\n      position: fixed;\n      top: 0;\n      width: 100%;\n      z-index: 100;\n      padding: 20px 40px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      background: linear-gradient(to bottom, rgba(10,10,10,0.95), transparent);\n    }\n\n    .nav-logo {\n      font-size: 13px;\n      font-weight: 700;\n      letter-spacing: 4px;\n      text-transform: uppercase;\n      color: var(--gold);\n      text-decoration: none;\n    }\n\n    .nav-tagline {\n      font-size: 11px;\n      letter-spacing: 3px;\n      text-transform: uppercase;\n      color: var(--gray);\n    }\n\n    /* ─── HERO ─── */\n    .hero {\n      position: relative;\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 120px 40px 80px;\n      overflow: hidden;\n    }\n\n    .hero-bg {\n      position: absolute;\n      inset: 0;\n      background:\n        radial-gradient(ellipse 80% 60% at 50% 40%, rgba(46,111,212,0.08) 0%, transparent 70%),\n        radial-gradient(ellipse 100% 100% at 50% 100%, rgba(244,192,18,0.04) 0%, transparent 60%),\n        var(--black);\n    }\n\n    .hero-eyebrow {\n      position: relative;\n      font-size: 13px;\n      font-weight: 700;\n      letter-spacing: 5px;\n      text-transform: uppercase;\n      color: var(--gold);\n      margin-bottom: 32px;\n      display: flex;\n      align-items: center;\n      gap: 16px;\n    }\n\n    .hero-eyebrow::before,\n    .hero-eyebrow::after {\n      content: '';\n      display: block;\n      width: 40px;\n      height: 1px;\n      background: var(--gold);\n      opacity: 0.5;\n    }\n\n    .hero-headline {\n      position: relative;\n      font-size: clamp(48px, 9vw, 110px);\n      font-weight: 900;\n      line-height: 0.9;\n      letter-spacing: -2px;\n      text-transform: uppercase;\n      margin-bottom: 16px;\n    }\n\n    .hero-headline .line-1 { color: var(--white); }\n    .hero-headline .line-2 {\n      color: transparent;\n      -webkit-text-stroke: 2px var(--gold);\n    }\n\n    .hero-divider {\n      position: relative;\n      width: 60px;\n      height: 3px;\n      background: var(--gold);\n      margin: 32px auto;\n    }\n\n    .hero-sub {\n      position: relative;\n      font-size: clamp(14px, 2vw, 18px);\n      font-weight: 400;\n      letter-spacing: 1px;\n      color: var(--light-gray);\n      max-width: 680px;\n      margin: 0 auto 48px;\n      line-height: 1.7;\n    }\n\n    .hero-cta {\n      position: relative;\n      display: inline-block;\n      background: var(--gold);\n      color: var(--black);\n      font-size: 13px;\n      font-weight: 900;\n      letter-spacing: 4px;\n      text-transform: uppercase;\n      text-decoration: none;\n      padding: 18px 48px;\n      transition: all 0.2s;\n    }\n\n    .hero-cta:hover {\n      background: var(--white);\n    }\n\n    .scroll-indicator {\n      position: absolute;\n      bottom: 0px;\n      left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .scroll-indicator span {\n      font-size: 10px;\n      letter-spacing: 3px;\n      text-transform: uppercase;\n      color: var(--gray);\n    }\n\n    .scroll-line {\n      width: 1px;\n      height: 40px;\n      background: linear-gradient(to bottom, var(--gray), transparent);\n    }\n\n    /* ─── VIDEO SECTION ─── */\n    .video-section {\n      background: var(--black-mid);\n      padding: 80px 40px;\n    }\n\n    .section-label {\n      text-align: center;\n      font-size: 16px;\n      font-weight: 700;\n      letter-spacing: 5px;\n      text-transform: uppercase;\n      color: var(--gold);\n      margin-bottom: 48px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 20px;\n    }\n\n    .section-label::before,\n    .section-label::after {\n      content: '';\n      display: block;\n      width: 60px;\n      height: 1px;\n      background: var(--gold);\n      opacity: 0.4;\n    }\n\n    .video-container {\n      max-width: 900px;\n      margin: 0 auto;\n    }\n\n    .video-embed {\n      position: relative;\n      width: 100%;\n      padding-top: 56.25%;\n      background: var(--black-light);\n      border: 1px solid #222;\n    }\n\n    /* Replace this with your actual YouTube/Vimeo embed */\n    .video-embed iframe {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n    }\n\n    .video-placeholder {\n      position: absolute;\n      inset: 0;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 20px;\n    }\n\n    .video-placeholder-icon {\n      width: 72px;\n      height: 72px;\n      border: 2px solid var(--gold);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .video-placeholder-icon svg {\n      width: 28px;\n      height: 28px;\n      fill: var(--gold);\n      margin-left: 4px;\n    }\n\n    .video-placeholder-text {\n      font-size: 12px;\n      letter-spacing: 3px;\n      text-transform: uppercase;\n      color: var(--gray);\n    }\n\n    .video-caption {\n      margin-top: 24px;\n      text-align: center;\n      font-size: 14px;\n      color: var(--gray);\n      font-style: italic;\n      letter-spacing: 0.5px;\n    }\n\n    /* ─── MANIFESTO ─── */\n    .manifesto {\n      max-width: 860px;\n      margin: 0 auto;\n      padding: 100px 40px;\n    }\n\n    .manifesto-headline {\n      font-size: clamp(32px, 5vw, 56px);\n      font-weight: 900;\n      letter-spacing: -1px;\n      text-transform: uppercase;\n      line-height: 1;\n      margin-bottom: 48px;\n    }\n\n    .manifesto-headline .accent { color: var(--gold); }\n\n    .manifesto p {\n      font-size: clamp(15px, 1.8vw, 18px);\n      line-height: 1.9;\n      color: var(--light-gray);\n      margin-bottom: 28px;\n    }\n\n    .manifesto p strong {\n      color: var(--white);\n      font-weight: 700;\n    }\n\n    .manifesto-stat {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 2px;\n      margin: 60px 0;\n      background: #222;\n    }\n\n    .stat-item {\n      background: var(--black-light);\n      padding: 32px 24px;\n      text-align: center;\n    }\n\n    .stat-number {\n      font-size: clamp(28px, 4vw, 44px);\n      font-weight: 900;\n      color: var(--gold);\n      line-height: 1;\n      margin-bottom: 8px;\n    }\n\n    .stat-label {\n      font-size: 11px;\n      letter-spacing: 2px;\n      text-transform: uppercase;\n      color: var(--gray);\n      line-height: 1.4;\n    }\n\n    .manifesto-pull {\n      border-left: 3px solid var(--gold);\n      padding-left: 28px;\n      margin: 48px 0;\n    }\n\n    .manifesto-pull p {\n      font-size: clamp(18px, 2.5vw, 24px);\n      font-weight: 700;\n      color: var(--white);\n      line-height: 1.5;\n      font-style: italic;\n    }\n\n    /* ─── THE STAND ─── */\n    .the-stand {\n      background: var(--black-light);\n      padding: 100px 40px;\n      text-align: center;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .the-stand-bg {\n      position: absolute;\n      inset: 0;\n      background: radial-gradient(ellipse 70% 80% at 50% 50%, rgba(244,192,18,0.05) 0%, transparent 70%);\n    }\n\n    .the-stand-content {\n      position: relative;\n      max-width: 760px;\n      margin: 0 auto;\n    }\n\n    .stand-headline {\n      font-size: clamp(36px, 6vw, 72px);\n      font-weight: 900;\n      text-transform: uppercase;\n      line-height: 0.95;\n      letter-spacing: -1px;\n      margin-bottom: 32px;\n    }\n\n    .stand-headline .accent { color: var(--gold); }\n\n    .the-stand p {\n      font-size: clamp(15px, 1.8vw, 18px);\n      color: var(--light-gray);\n      line-height: 1.8;\n      margin-bottom: 20px;\n    }\n\n    /* ─── QUESTIONS ─── */\n    .questions-section {\n      padding: 100px 40px;\n      max-width: 1100px;\n      margin: 0 auto;\n    }\n\n    .questions-header {\n      margin-bottom: 64px;\n      max-width: 600px;\n    }\n\n    .questions-header h2 {\n      font-size: clamp(28px, 4vw, 44px);\n      font-weight: 900;\n      text-transform: uppercase;\n      letter-spacing: -0.5px;\n      line-height: 1.05;\n      margin-bottom: 20px;\n    }\n\n    .questions-header h2 .accent { color: var(--gold); }\n\n    .questions-header p {\n      font-size: 15px;\n      color: var(--light-gray);\n      line-height: 1.7;\n    }\n\n    .questions-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 2px;\n      background: #1a1a1a;\n    }\n\n    .question-card {\n      background: var(--black-mid);\n      padding: 48px 36px;\n      position: relative;\n    }\n\n    .question-card::before {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      height: 3px;\n      background: var(--gold);\n    }\n\n    .q-number {\n      font-size: 80px;\n      font-weight: 900;\n      color: #1e1e1e;\n      line-height: 1;\n      position: absolute;\n      top: 20px;\n      right: 24px;\n      letter-spacing: -3px;\n    }\n\n    .q-label {\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: 3px;\n      text-transform: uppercase;\n      color: var(--gold);\n      margin-bottom: 20px;\n    }\n\n    .q-text {\n      font-size: clamp(16px, 2vw, 20px);\n      font-weight: 700;\n      line-height: 1.3;\n      color: var(--white);\n      position: relative;\n    }\n\n    /* ─── SUBMIT ─── */\n    .submit-section {\n      background: var(--black-mid);\n      padding: 100px 40px;\n    }\n\n    .submit-inner {\n      max-width: 860px;\n      margin: 0 auto;\n    }\n\n    .submit-headline {\n      font-size: clamp(28px, 4.5vw, 52px);\n      font-weight: 900;\n      text-transform: uppercase;\n      line-height: 1;\n      letter-spacing: -1px;\n      margin-bottom: 20px;\n    }\n\n    .submit-headline .accent { color: var(--gold); }\n\n    .submit-sub {\n      font-size: clamp(14px, 1.8vw, 17px);\n      color: var(--light-gray);\n      line-height: 1.7;\n      margin-bottom: 56px;\n      max-width: 600px;\n    }\n\n    .submit-steps {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 2px;\n      background: #1a1a1a;\n      margin-bottom: 56px;\n    }\n\n    .step {\n      background: var(--black-light);\n      padding: 32px 24px;\n    }\n\n    .step-num {\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: 3px;\n      color: var(--gold);\n      margin-bottom: 16px;\n    }\n\n    .step-text {\n      font-size: 14px;\n      line-height: 1.5;\n      color: var(--light-gray);\n    }\n\n    .step-text strong { color: var(--white); }\n\n    .submit-note {\n      font-size: 13px;\n      color: var(--gray);\n      line-height: 1.7;\n      border-top: 1px solid #222;\n      padding-top: 32px;\n      margin-bottom: 40px;\n    }\n\n    .submit-ctas {\n      display: flex;\n      gap: 16px;\n      flex-wrap: wrap;\n      align-items: center;\n    }\n\n    .btn-primary {\n      display: inline-block;\n      background: var(--gold);\n      color: var(--black);\n      font-size: 13px;\n      font-weight: 900;\n      letter-spacing: 4px;\n      text-transform: uppercase;\n      text-decoration: none;\n      padding: 18px 48px;\n      transition: all 0.2s;\n    }\n\n    .btn-primary:hover { background: var(--white); }\n\n    .btn-secondary {\n      display: inline-block;\n      border: 1px solid var(--cobalt);\n      color: var(--cobalt);\n      font-size: 13px;\n      font-weight: 700;\n      letter-spacing: 3px;\n      text-transform: uppercase;\n      text-decoration: none;\n      padding: 17px 36px;\n      transition: all 0.2s;\n    }\n\n    .btn-secondary:hover {\n      background: var(--cobalt);\n      color: var(--white);\n    }\n\n    /* ─── GALLERY TEASER ─── */\n    .gallery-teaser {\n      padding: 80px 40px;\n      text-align: center;\n    }\n\n    .gallery-teaser p {\n      font-size: 14px;\n      color: var(--gray);\n      letter-spacing: 1px;\n      margin-bottom: 8px;\n    }\n\n    .gallery-teaser h3 {\n      font-size: clamp(20px, 3vw, 32px);\n      font-weight: 900;\n      text-transform: uppercase;\n      letter-spacing: -0.5px;\n      margin-bottom: 40px;\n    }\n\n    .gallery-teaser h3 .accent { color: var(--gold); }\n\n    .placeholder-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 2px;\n      max-width: 1000px;\n      margin: 0 auto;\n    }\n\n    .placeholder-card {\n      background: var(--black-light);\n      aspect-ratio: 9/16;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .placeholder-card::before {\n      content: '▶';\n      font-size: 24px;\n      color: rgba(244,192,18,0.3);\n    }\n\n    .placeholder-card:nth-child(2) { opacity: 0.7; }\n    .placeholder-card:nth-child(3) { opacity: 0.5; }\n    .placeholder-card:nth-child(4) { opacity: 0.3; }\n\n    .gallery-coming-soon {\n      font-size: 11px;\n      letter-spacing: 3px;\n      text-transform: uppercase;\n      color: var(--gray);\n      margin-top: 24px;\n    }\n\n   \n\n    /* ─── RESPONSIVE ─── */\n    @media (max-width: 768px) {\n      nav { padding: 16px 24px; }\n      .nav-tagline { display: none; }\n      .hero { padding: 100px 24px 60px; }\n\n      .manifesto { padding: 60px 24px; }\n      .manifesto-stat { grid-template-columns: 1fr; }\n      .manifesto-stat { gap: 2px; }\n\n      .the-stand { padding: 60px 24px; }\n      .questions-section { padding: 60px 24px; }\n      .questions-grid { grid-template-columns: 1fr; }\n\n      .submit-section { padding: 60px 24px; }\n      .submit-steps { grid-template-columns: repeat(2, 1fr); }\n\n      .gallery-teaser { padding: 60px 24px; }\n      .placeholder-grid { grid-template-columns: repeat(2, 1fr); }\n      .placeholder-card:nth-child(3),\n      .placeholder-card:nth-child(4) { display: none; }\n\n      footer {\n        padding: 32px 24px;\n        flex-direction: column;\n        align-items: flex-start;\n        gap: 16px;\n      }\n\n      .submit-ctas { flex-direction: column; align-items: flex-start; }\n    }\n  </style>\n\n\n\n  <!-- NAV -->\n  <nav>\n    <a href=\"https://findingfullthrottle.com\" class=\"nav-logo\">Finding Full Throttle</a>\n    <span class=\"nav-tagline\">3 Pedal Society</span>\n  </nav>\n\n  <!-- HERO -->\n  <section class=\"hero\">\n    <div class=\"hero-bg\"></div>\n    <div class=\"hero-eyebrow\">3 Pedal Society</div>\n    <h1 class=\"hero-headline\">\n      <div class=\"line-1\">THE MANUAL IS</div>\n      <div class=\"line-2\">DYING.</div>\n    </h1>\n    <div class=\"hero-divider\"></div>\n    <p class=\"hero-sub\">\n      The manufacturers have decided. The dealers have moved on. Every year, fewer people learn on three pedals. The world has made its choice.<br><br>\n      <strong style=\"color: #fff;\">We haven't.</strong>\n    </p>\n    <a href=\"#submit\" class=\"hero-cta\">Submit Your Story</a>\n    <div class=\"scroll-indicator\">\n      <span>Scroll</span>\n      <div class=\"scroll-line\"></div>\n    </div>\n  </section>\n\n  <!-- VINCE VIDEO -->\n  <section class=\"video-section\">\n    <div class=\"section-label\">Watch First</div>\n    <div class=\"video-container\">\n      <div class=\"video-embed\">\n<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/IIFZHq4Q2WU?si=Mc45YG7PEO4vOsao&amp;controls=0\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen=\"\"></iframe>\n        </div>\n      </div>\n      <p class=\"video-caption\">A message from the 3 Pedal Society on why your story matters.</p>\n    \n  </section>\n\n  <!-- MANIFESTO -->\n  <section>\n    <div class=\"manifesto\">\n      <h2 class=\"manifesto-headline\">\n        The <span class=\"accent\">Numbers</span><br>Don't Lie.\n      </h2>\n\n      <p>In 1980, more than <strong>35% of cars sold in America</strong> had a manual transmission. Today, that number is under 2%. Not because drivers stopped wanting them. Because manufacturers stopped making them.</p>\n\n      <p>Every year, automakers announce another model that's going automatic-only. EV platforms don't even have transmissions. The engineers have made the math work. The accountants approved it. The dealers stopped stocking them.</p>\n\n      <div class=\"manifesto-stat\">\n        <div class=\"stat-item\">\n          <div class=\"stat-number\">&lt;2%</div>\n          <div class=\"stat-label\">of new cars sold<br>with a manual</div>\n        </div>\n        <div class=\"stat-item\">\n          <div class=\"stat-number\">~40</div>\n          <div class=\"stat-label\">manual options<br>left in market</div>\n        </div>\n        <div class=\"stat-item\">\n          <div class=\"stat-number\">10yrs</div>\n          <div class=\"stat-label\">until manuals may<br>leave the market</div>\n        </div>\n      </div>\n\n      <p>The kids learning to drive today may never sit behind three pedals. The teenager who gets handed a key to the family car and has to figure it out in the driveway, stalling over and over until it clicks — that experience is <strong>disappearing</strong>.</p>\n\n      <div class=\"manifesto-pull\">\n        <p>\"The people who choose manual aren't doing it because it's easier. They're doing it because it's a conversation. You and the machine. Three pedals. One hand on the shifter. All the way in.\"</p>\n      </div>\n\n      <p>The cars are dying. But <strong>the stories don't have to go with them.</strong></p>\n    </div>\n  </section>\n\n  <!-- THE STAND -->\n  <section class=\"the-stand\">\n    <div class=\"the-stand-bg\"></div>\n    <div class=\"the-stand-content\">\n      <div class=\"section-label\">Our Response</div>\n      <h2 class=\"stand-headline\">\n        We're Planting<br>Our <span class=\"accent\">Flag.</span>\n      </h2>\n      <p>Finding Full Throttle exists because manual drivers are a different breed. You chose this. You kept choosing it. You still choose it every morning when you back out of the driveway.</p>\n      <p>We're building the platform where three-pedal culture lives forever. Where the stories get told. Where the next generation can find out what it meant to be a manual driver — because the people who lived it put it on record.</p>\n      <p><strong style=\"color: var(--white);\">This is the 3 Pedal Society Stories archive. And we want yours in it.</strong></p>\n    </div>\n  </section>\n\n  <!-- QUESTIONS -->\n  <section class=\"questions-section\">\n    <div class=\"questions-header\">\n      <div class=\"section-label\" style=\"justify-content: flex-start;\">\n        <span>Three Questions</span>\n        <div style=\"width: 60px; height: 1px; background: var(--gold); opacity: 0.4;\"></div>\n      </div>\n      <h2>Answer These.<br><span class=\"accent\">On Camera.</span>\n</h2>\n      <p>Record a short video — phone camera is perfect. Find good light, speak from the heart. We don't need production quality. We need your truth.</p>\n    </div>\n\n    <div class=\"questions-grid\">\n\n      <div class=\"question-card\">\n        <div class=\"q-number\">01</div>\n        <div class=\"q-label\">Question One</div>\n        <div class=\"q-text\">When did you first learn to drive manual — and who taught you?</div>\n      </div>\n\n      <div class=\"question-card\">\n        <div class=\"q-number\">02</div>\n        <div class=\"q-label\">Question Two</div>\n        <div class=\"q-text\">What's your favorite thing about driving stick?</div>\n      </div>\n\n      <div class=\"question-card\">\n        <div class=\"q-number\">03</div>\n        <div class=\"q-label\">Question Three</div>\n        <div class=\"q-text\">What does the 3 Pedal Society mean to you?</div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- SUBMIT -->\n  <section class=\"submit-section\" id=\"submit\">\n    <div class=\"submit-inner\">\n      <div class=\"section-label\" style=\"justify-content: flex-start;\">\n        <span>Submit Your Story</span>\n        <div style=\"width: 60px; height: 1px; background: var(--gold); opacity: 0.4;\"></div>\n      </div>\n      <h2 class=\"submit-headline\">\n        Your Story<br><span class=\"accent\">Belongs Here.</span>\n      </h2>\n      <p class=\"submit-sub\">We're building the archive. Every submission gets reviewed. The best stories get featured across our social channels — reaching thousands of drivers who get it.</p>\n\n      <div class=\"submit-steps\">\n        <div class=\"step\">\n          <div class=\"step-num\">Step 01</div>\n          <div class=\"step-text\">\n<strong>Record your video.</strong> Phone camera is fine. Answer all three questions. Keep it under 3 minutes.</div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">Step 02</div>\n          <div class=\"step-text\">\n<strong>Wear your merch</strong> if you have it. If you don't, that's okay. What matters is the story.</div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">Step 03</div>\n          <div class=\"step-text\">\n<strong>Send it in.</strong> DM us on Instagram @findingfullthrottle or email the link to stories@findingfullthrottle.com</div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">Step 04</div>\n          <div class=\"step-text\">\n<strong>Get featured.</strong> Selected stories are posted to our channels and added to the permanent archive.</div>\n        </div>\n      </div>\n\n      <p class=\"submit-note\">By submitting, you give Finding Full Throttle permission to share your video on social media, email, and our website. We'll always credit you. We'll never edit your words. The archive is yours as much as ours.</p>\n\n      <div class=\"submit-ctas\">\n        <a href=\"https://www.instagram.com/findingfullthrottle\" class=\"btn-primary\">DM Us on Instagram</a>\n        <a href=\"mailto:stories@findingfullthrottle.com\" class=\"btn-secondary\">Email Your Story</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- GALLERY TEASER -->\n  <section class=\"gallery-teaser\">\n    <p>Stories From The Community</p>\n    <h3>The <span class=\"accent\">Archive</span> Is Growing.</h3>\n    <div class=\"placeholder-grid\">\n      <div class=\"placeholder-card\"></div>\n      <div class=\"placeholder-card\"></div>\n      <div class=\"placeholder-card\"></div>\n      <div class=\"placeholder-card\"></div>\n    </div>\n    <p class=\"gallery-coming-soon\">— First stories dropping soon —</p>\n  </section>",
