<!-- /sections/section-sale-trust-badges.liquid -->
{%- liquid
  assign animation_anchor = '#SaleTrustBadges--' | append: section.id
  assign animation_order = 0
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign grid_columns = section.settings.grid_columns

  assign columns_desktop = grid_columns | plus: 0
  assign columns_medium = 3
  assign columns_small = 2
  assign columns_mobile = 2

  if columns_desktop == 2 or columns_desktop == 4
    assign columns_medium = 2
  endif
-%}

{%- style -%}
  #SaleTrustBadges--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    --COLUMNS: {{ columns_desktop }};
    --COLUMNS-MEDIUM: {{ columns_medium }};
    --COLUMNS-SMALL: {{ columns_small }};
    --COLUMNS-MOBILE: {{ columns_mobile }};
  }
{%- endstyle -%}

<section id="SaleTrustBadges--{{ section.id }}"
  class="index-sale-trust-badges section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="sale-trust-badges">
  <div class="{{ section.settings.width }}">
    {%- if section.blocks.size > 0 -%}
      <div class="grid grid--{{ columns_desktop }}-col-desktop grid--{{ columns_medium }}-col-medium grid--{{ columns_small }}-col-small grid--{{ columns_mobile }}-col-mobile">
        {%- for block in section.blocks -%}
          {%- assign animation_order = animation_order | plus: 1 -%}
          <div class="grid__item trust-badge"
            data-aos="fade-up"
            data-aos-anchor="{{ animation_anchor }}"
            data-aos-order="{{ animation_order }}"
            {{ block.shopify_attributes }}>
            
            {%- if block.settings.icon != blank -%}
              <div class="trust-badge__icon">
                {%- render 'image', image: block.settings.icon, sizes: '80px' -%}
              </div>
            {%- elsif block.settings.icon_name != blank -%}
              <div class="trust-badge__icon trust-badge__icon--svg">
                {%- case block.settings.icon_name -%}
                  {%- when 'shipping' -%}
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20 8H17L15 6H9L7 8H4C2.9 8 2 8.9 2 10V17C2 18.1 2.9 19 4 19H20C21.1 19 22 18.1 22 17V10C22 8.9 21.1 8 20 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12 17C13.6569 17 15 15.6569 15 14C15 12.3431 13.6569 11 12 11C10.3431 11 9 12.3431 9 14C9 15.6569 10.3431 17 12 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'return' -%}
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 9L12 2L21 9V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9 22V12H15V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'secure' -%}
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'support' -%}
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M21 15C21 15.5304 20.7893 16.0391 20.4142 16.4142C20.0391 16.7893 19.5304 17 19 17H7L3 21V5C3 4.46957 3.21071 3.96086 3.58579 3.58579C3.96086 3.21071 4.46957 3 5 3H19C19.5304 3 20.0391 3.21071 20.4142 3.58579C20.7893 3.96086 21 4.46957 21 5V15Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                {%- endcase -%}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="trust-badge__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="trust-badge__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #SaleTrustBadges--{{ section.id }} .trust-badge {
    text-align: center;
    padding: 2rem 1rem;
  }

  #SaleTrustBadges--{{ section.id }} .trust-badge__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #SaleTrustBadges--{{ section.id }} .trust-badge__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #SaleTrustBadges--{{ section.id }} .trust-badge__icon--svg svg {
    width: 100%;
    height: 100%;
    color: var(--color-btn-primary);
  }

  #SaleTrustBadges--{{ section.id }} .trust-badge__title {
    margin: 0 0 0.5rem 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  #SaleTrustBadges--{{ section.id }} .trust-badge__description {
    margin: 0;
    font-size: 0.875rem;
    color: rgba(var(--color-text), 0.7);
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    #SaleTrustBadges--{{ section.id }} .trust-badge {
      padding: 1.5rem 1rem;
    }
  }
{%- endstyle -%}

{% schema %}
  {
    "name": "Sale Trust Badges",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "select",
        "id": "width",
        "label": "Width",
        "default": "wrapper--full-padded",
        "options": [
          {"value": "wrapper--full", "label": "Full width"},
          {"value": "wrapper--full-padded", "label": "Full width padded"},
          {"value": "wrapper", "label": "Normal"}
        ]
      },
      {
        "type": "range",
        "id": "grid_columns",
        "label": "Columns",
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 4
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color scheme"
      },
      {
        "type": "header",
        "content": "Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Top",
        "default": 50
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Bottom",
        "default": 50
      }
    ],
    "blocks": [
      {
        "type": "badge",
        "name": "Trust Badge",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon image",
            "info": "Optional - upload custom icon"
          },
          {
            "type": "select",
            "id": "icon_name",
            "label": "Icon",
            "info": "Choose a default icon if no custom image",
            "default": "shipping",
            "options": [
              {"value": "", "label": "None"},
              {"value": "shipping", "label": "Shipping"},
              {"value": "return", "label": "Returns"},
              {"value": "secure", "label": "Secure"},
              {"value": "support", "label": "Support"}
            ]
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Free Shipping"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "On orders over $50"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Sale Trust Badges",
        "blocks": [
          {
            "type": "badge",
            "settings": {
              "icon_name": "shipping",
              "title": "Free Shipping",
              "description": "On orders over $50"
            }
          },
          {
            "type": "badge",
            "settings": {
              "icon_name": "return",
              "title": "Easy Returns",
              "description": "30-day return policy"
            }
          },
          {
            "type": "badge",
            "settings": {
              "icon_name": "secure",
              "title": "Secure Checkout",
              "description": "100% secure payment"
            }
          },
          {
            "type": "badge",
            "settings": {
              "icon_name": "support",
              "title": "24/7 Support",
              "description": "Dedicated support"
            }
          }
        ]
      }
    ],
    "disabled_on": {
      "groups": ["header", "footer", "aside"]
    }
  }
{% endschema %}

