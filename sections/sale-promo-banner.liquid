{{ 'sale-promo-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme | default: ''
-%}

{%- style -%}
  #sale-promo-banner-{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 749px) {
    #sale-promo-banner-{{ section.id }} > div {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
{%- endstyle -%}

<section class="sale-promo-banner sale-promo-banner-{{ section.id }} section-padding {{ color_scheme }}" id="sale-promo-banner-{{ section.id }}">
  <div class="{{ section.settings.width | default: 'wrapper--full-padded' }}">
    <div class="promo-banner-wrapper">
      {% if section.settings.badge_text != blank %}
        <div class="promo-badge">{{ section.settings.badge_text }}</div>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="promo-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      
      {% if section.settings.subheading != blank %}
        <p class="promo-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <div class="promo-description">{{ section.settings.description }}</div>
      {% endif %}
      
      {% if section.settings.product != blank %}
        <div class="promo-product-info">
          <div class="promo-product-price">
            {% if section.settings.original_price != blank %}
              <span class="original-price">{{ section.settings.original_price }}</span>
            {% endif %}
            <span class="current-price">{{ section.settings.current_price | default: 'FREE' }}</span>
          </div>
        </div>
      {% endif %}
      
      {% if section.settings.button_text != blank and section.settings.button_url != blank %}
        <a href="{{ section.settings.button_url }}" class="btn {{ section.settings.button_style }} {{ section.settings.button_size }} {{ section.settings.button_type }}">
          <span>{{ section.settings.button_text }}</span>
        </a>
      {% endif %}
      
      {% if section.settings.image != blank %}
        <div class="promo-image-wrapper">
          <img 
            src="{{ section.settings.image | image_url: width: 600 }}" 
            alt="{{ section.settings.image.alt | escape }}"
            class="promo-image"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .sale-promo-banner-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .sale-promo-banner-{{ section.id }} .promo-heading {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Sale Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FREE Hot Lava Hot Sauce with Your Purchase!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREE Hot Lava Hot Sauce with Your Purchase!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Purchase any Meal or Bundle and we'll add it to your order automatically. No coupon needed."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>The sauce that always sells out is BACK! Turn up the heat on your favorite meals with Hot Lava Hot Sauce, the ultimate chili blend that's as versatile as it is flavorful.</p>"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "original_price",
      "label": "Original Price",
      "default": "$8.95"
    },
    {
      "type": "text",
      "id": "current_price",
      "label": "Current Price",
      "default": "FREE"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Our Full Menu"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        {"value": "wrapper--full", "label": "Full width"},
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Normal"}
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ],
  "presets": [
    {
      "name": "Sale Promo Banner"
    }
  ]
}
{% endschema %}

