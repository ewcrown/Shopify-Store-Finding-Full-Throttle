{{ 'sale-countdown.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme | default: ''
-%}

{%- style -%}
  #sale-countdown-{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 749px) {
    #sale-countdown-{{ section.id }} > div {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
{%- endstyle -%}

<section class="sale-countdown-section sale-countdown-{{ section.id }} section-padding {{ color_scheme }}" id="sale-countdown-{{ section.id }}">
  <div class="{{ section.settings.width | default: 'wrapper--full-padded' }}">
    <div class="sale-countdown-wrapper">
      {% if section.settings.heading != blank %}
        <h2 class="sale-countdown-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      
      <div class="countdown-timer" data-end-date="{{ section.settings.end_date }}">
        <div class="countdown-item">
          <span class="countdown-value" id="days-{{ section.id }}">00</span>
          <span class="countdown-label">Days</span>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <span class="countdown-value" id="hours-{{ section.id }}">00</span>
          <span class="countdown-label">Hours</span>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <span class="countdown-value" id="minutes-{{ section.id }}">00</span>
          <span class="countdown-label">Minutes</span>
        </div>
        <div class="countdown-separator">:</div>
        <div class="countdown-item">
          <span class="countdown-value" id="seconds-{{ section.id }}">00</span>
          <span class="countdown-label">Seconds</span>
        </div>
      </div>

      {% if section.settings.subheading != blank %}
        <p class="sale-countdown-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .sale-countdown-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .sale-countdown-{{ section.id }} .sale-countdown-heading {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size }}px;
  }
  .sale-countdown-{{ section.id }} .sale-countdown-subheading {
    color: {{ section.settings.text_color }};
    margin-top: 20px;
  }
{% endstyle %}

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const countdownElement = document.querySelector(`#sale-countdown-${sectionId} .countdown-timer`);
    
    if (!countdownElement) return;
    
    const endDateString = countdownElement.getAttribute('data-end-date');
    if (!endDateString) {
      console.warn('Countdown timer: No end date specified');
      return;
    }
    
    // Parse the end date - handle both ISO format and other formats
    let countdownDate;
    try {
      // Try parsing as ISO string first
      countdownDate = new Date(endDateString).getTime();
      
      // If invalid, try parsing as a different format
      if (isNaN(countdownDate)) {
        // Try parsing as YYYY-MM-DDTHH:MM:SS
        const parts = endDateString.split('T');
        if (parts.length === 2) {
          const datePart = parts[0].split('-');
          const timePart = parts[1].split(':');
          countdownDate = new Date(
            parseInt(datePart[0]),
            parseInt(datePart[1]) - 1,
            parseInt(datePart[2]),
            parseInt(timePart[0] || 0),
            parseInt(timePart[1] || 0),
            parseInt(timePart[2] || 0)
          ).getTime();
        }
      }
    } catch (e) {
      console.error('Countdown timer: Error parsing date', e);
      return;
    }
    
    if (isNaN(countdownDate)) {
      console.error('Countdown timer: Invalid date format');
      return;
    }
    
    const daysEl = document.getElementById(`days-${sectionId}`);
    const hoursEl = document.getElementById(`hours-${sectionId}`);
    const minutesEl = document.getElementById(`minutes-${sectionId}`);
    const secondsEl = document.getElementById(`seconds-${sectionId}`);
    
    if (!daysEl || !hoursEl || !minutesEl || !secondsEl) {
      console.error('Countdown timer: Could not find countdown elements');
      return;
    }
    
    function updateCountdown() {
      const now = new Date().getTime();
      const distance = countdownDate - now;
      
      if (distance < 0) {
        // Countdown has ended
        daysEl.textContent = '00';
        hoursEl.textContent = '00';
        minutesEl.textContent = '00';
        secondsEl.textContent = '00';
        return;
      }
      
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);
      
      daysEl.textContent = String(days).padStart(2, '0');
      hoursEl.textContent = String(hours).padStart(2, '0');
      minutesEl.textContent = String(minutes).padStart(2, '0');
      secondsEl.textContent = String(seconds).padStart(2, '0');
    }
    
    // Update immediately
    updateCountdown();
    
    // Update every second
    const intervalId = setInterval(updateCountdown, 1000);
    
    // Clean up interval if element is removed from DOM
    if (typeof MutationObserver !== 'undefined') {
      const observer = new MutationObserver(function(mutations) {
        if (!document.contains(countdownElement)) {
          clearInterval(intervalId);
          observer.disconnect();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>

{% schema %}
{
  "name": "Sale Countdown Timer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW YEAR SALE ENDS IN"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End Date & Time",
      "info": "Format: YYYY-MM-DDTHH:MM:SS (e.g., 2024-12-31T23:59:59)",
      "default": "2024-12-31T23:59:59"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "No Coupon Needed. Spend $130, Save $15. Spend $170, Save $20. Spend $200, Save $30."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        {"value": "wrapper--full", "label": "Full width"},
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Normal"}
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ],
  "presets": [
    {
      "name": "Sale Countdown Timer"
    }
  ]
}
{% endschema %}

