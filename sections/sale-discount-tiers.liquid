{{ 'sale-discount-tiers.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme | default: ''
-%}

{%- style -%}
  #sale-discount-tiers-{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 749px) {
    #sale-discount-tiers-{{ section.id }} > div {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
{%- endstyle -%}

<section class="sale-discount-tiers sale-discount-tiers-{{ section.id }} section-padding {{ color_scheme }}" id="sale-discount-tiers-{{ section.id }}">
  <div class="{{ section.settings.width | default: 'wrapper--full-padded' }}">
    <div class="discount-tiers-wrapper">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="discount-tier-image" {{ block.shopify_attributes }}>
            {% if block.settings.link_url != blank %}
              <a href="{{ block.settings.link_url }}" class="tier-image-link">
            {% endif %}
            <img 
              src="{{ block.settings.image | image_url: width: 800 }}" 
              alt="{{ block.settings.image.alt | default: 'Discount Tier' | escape }}"
              class="tier-image"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
            {% if block.settings.link_url != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .sale-discount-tiers-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Sale Discount Tiers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        {"value": "wrapper--full", "label": "Full width"},
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Normal"}
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Discount Tier Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload the discount tier image"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL",
          "info": "Optional: Add a link to the image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sale Discount Tiers"
    }
  ]
}
{% endschema %}

