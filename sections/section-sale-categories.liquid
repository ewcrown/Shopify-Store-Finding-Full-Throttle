<!-- /sections/section-sale-categories.liquid -->
{%- liquid
  assign animation_anchor = '#SaleCategories--' | append: section.id
  assign animation_order = 0
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign grid_columns = section.settings.grid_columns
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign has_content = false
  if heading != blank or description != blank
    assign has_content = true
  endif

  assign columns_desktop = grid_columns | plus: 0
  assign columns_medium = 3
  assign columns_small = 2
  assign columns_mobile = 2

  if columns_desktop == 2 or columns_desktop == 4
    assign columns_medium = 2
  endif

  assign aspect_ratio = 1 | divided_by: section.settings.aspect_ratio
-%}

{%- style -%}
  #SaleCategories--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    --COLUMNS: {{ columns_desktop }};
    --COLUMNS-MEDIUM: {{ columns_medium }};
    --COLUMNS-SMALL: {{ columns_small }};
    --COLUMNS-MOBILE: {{ columns_mobile }};

    {%- if has_content -%}
      --PT-MOBILE: max({{ section.settings.padding_top }}px, calc(var(--gutter) * 2));
    {%- endif -%}
  }
{%- endstyle -%}

<section id="SaleCategories--{{ section.id }}"
  class="index-sale-categories section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="sale-categories">
  <div class="grid-container">
    {%- if has_content -%}
      <div class="grid__heading-holder text-center">
        {%- if heading != blank or description != blank -%}
          <div class="grid__heading-text">
            {%- if heading != blank -%}
              {%- liquid
                assign animation_order = animation_order | plus: 1
                assign heading_tag = 'h2'

                unless section.settings.heading_tag == 'automatic' or section.settings.heading_tag == blank
                  assign heading_tag = section.settings.heading_tag
                endunless
              -%}

              <{{ heading_tag }} class="grid__heading {{ section.settings.heading_font_size }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}">
                {{ heading }}
              </{{ heading_tag }}>
            {%- endif -%}

            {%- if description != blank -%}
              {%- assign animation_order = animation_order | plus: 1 -%}
              <div class="grid__description {{ section.settings.text_font_size }}"
                data-aos="hero"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}">
                {{ description }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="grid__items-holder">
        <div class="grid-outer">
          <div class="grid grid--{{ columns_desktop }}-col-desktop grid--{{ columns_medium }}-col-medium grid--{{ columns_small }}-col-small grid--{{ columns_mobile }}-col-mobile">
            {%- for block in section.blocks -%}
              {%- assign animation_order = animation_order | plus: 1 -%}
              {%- assign collection = collections[block.settings.collection] -%}
              {%- assign collection_image = block.settings.image | default: collection.featured_image -%}
              {%- assign collection_title = block.settings.title | default: collection.title -%}
              {%- assign collection_url = collection.url | default: block.settings.link -%}
              
              <div class="grid__item"
                data-aos="fade-up"
                data-aos-anchor="{{ animation_anchor }}"
                data-aos-order="{{ animation_order }}"
                {{ block.shopify_attributes }}>
                <a href="{{ collection_url }}" class="collection-card">
                  {%- if collection_image != blank -%}
                    <div class="collection-card__image" style="--aspect-ratio: {{ aspect_ratio }};">
                      {%- render 'image', image: collection_image, sizes: '(min-width: 990px) calc((100vw - 100px) / {{ columns_desktop }}), (min-width: 750px) calc((100vw - 50px) / {{ columns_medium }}), calc((100vw - 32px) / {{ columns_mobile }})' -%}
                      {%- if block.settings.overlay_text != blank -%}
                        <div class="collection-card__overlay">
                          <span class="collection-card__overlay-text">{{ block.settings.overlay_text }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="collection-card__content">
                    {%- if collection_title != blank -%}
                      <h3 class="collection-card__title">{{ collection_title }}</h3>
                    {%- endif -%}

                    {%- if block.settings.description != blank -%}
                      <p class="collection-card__description">{{ block.settings.description }}</p>
                    {%- elsif collection.description != blank -%}
                      <p class="collection-card__description">{{ collection.description | strip_html | truncatewords: 15 }}</p>
                    {%- endif -%}

                    {%- if block.settings.button_text != blank -%}
                      <span class="btn btn--small btn--primary">{{ block.settings.button_text }}</span>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- else -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #SaleCategories--{{ section.id }} .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #SaleCategories--{{ section.id }} .collection-card:hover {
    transform: translateY(-5px);
  }

  #SaleCategories--{{ section.id }} .collection-card__image {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  #SaleCategories--{{ section.id }} .collection-card__image img {
    transition: transform 0.3s ease;
  }

  #SaleCategories--{{ section.id }} .collection-card:hover .collection-card__image img {
    transform: scale(1.05);
  }

  #SaleCategories--{{ section.id }} .collection-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #SaleCategories--{{ section.id }} .collection-card:hover .collection-card__overlay {
    opacity: 1;
  }

  #SaleCategories--{{ section.id }} .collection-card__overlay-text {
    color: white;
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  #SaleCategories--{{ section.id }} .collection-card__content {
    padding: 1.5rem 0;
    text-align: center;
  }

  #SaleCategories--{{ section.id }} .collection-card__title {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
  }

  #SaleCategories--{{ section.id }} .collection-card__description {
    margin: 0 0 1rem 0;
    color: rgba(var(--color-text), 0.7);
    font-size: 0.875rem;
  }
{%- endstyle -%}

{% schema %}
  {
    "name": "Sale Categories",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Shop by Category"
      },
      {
        "type": "select",
        "id": "heading_font_size",
        "label": "Heading size",
        "default": "heading-large",
        "options": [
          {"value": "heading-mini", "label": "Mini"},
          {"value": "heading-x-small", "label": "Extra small"},
          {"value": "heading-small", "label": "Small"},
          {"value": "heading-medium", "label": "Medium"},
          {"value": "heading-large", "label": "Large"},
          {"value": "heading-x-large", "label": "Extra large"}
        ]
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "select",
        "id": "text_font_size",
        "label": "Text size",
        "default": "body-medium",
        "options": [
          {"value": "body-x-small", "label": "Extra small"},
          {"value": "body-small", "label": "Small"},
          {"value": "body-medium", "label": "Medium"},
          {"value": "body-large", "label": "Large"}
        ]
      },
      {
        "type": "header",
        "content": "Advanced"
      },
      {
        "type": "select",
        "id": "heading_tag",
        "label": "Heading SEO tag",
        "default": "automatic",
        "options": [
          {"value": "automatic", "label": "Automatic"},
          {"value": "h1", "label": "H1"},
          {"value": "h2", "label": "H2"},
          {"value": "h3", "label": "H3"}
        ]
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "grid_columns",
        "label": "Columns",
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "aspect_ratio",
        "label": "Image aspect ratio",
        "min": 0.5,
        "max": 2,
        "step": 0.1,
        "default": 1
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color scheme"
      },
      {
        "type": "header",
        "content": "Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Top",
        "default": 50
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Bottom",
        "default": 50
      }
    ],
    "blocks": [
      {
        "type": "category",
        "name": "Category",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "info": "Leave blank to use collection title"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Used if no collection is selected"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "Leave blank to use collection image"
          },
          {
            "type": "text",
            "id": "overlay_text",
            "label": "Overlay text",
            "info": "Text displayed on hover"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "info": "Leave blank to use collection description"
          },
          {
            "type": "text",
            "id": "button_text",
            "label": "Button text",
            "default": "Shop Now"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Sale Categories",
        "blocks": [
          {
            "type": "category"
          },
          {
            "type": "category"
          },
          {
            "type": "category"
          }
        ]
      }
    ],
    "disabled_on": {
      "groups": ["header", "footer", "aside"]
    }
  }
{% endschema %}

